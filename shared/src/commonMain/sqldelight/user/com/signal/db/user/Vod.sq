-- Movies and series (PLAN §4.3.6–4.3.7): cached source data, rebuilt on every source refresh and
-- never edited, like stream. What the user does with them (Library, resume, watched) is elsewhere.
CREATE TABLE vod_category (
    source_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    category_id TEXT NOT NULL,
    name TEXT NOT NULL,
    position INTEGER NOT NULL,
    PRIMARY KEY (source_id, kind, category_id)
);

CREATE TABLE vod_item (
    id TEXT NOT NULL PRIMARY KEY,
    source_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    provider_id TEXT NOT NULL,
    name TEXT NOT NULL,
    category_id TEXT NOT NULL,
    poster_url TEXT,
    year INTEGER,
    rating REAL,
    added_at INTEGER NOT NULL DEFAULT 0,
    tmdb_id INTEGER,
    container_ext TEXT,
    plot TEXT,
    url TEXT,
    position INTEGER NOT NULL,
    -- For matching titles across sources and with the guide (VodTitles.nameKey), and for Search (SearchText.fold).
    title_key TEXT NOT NULL DEFAULT '',
    search_name TEXT NOT NULL DEFAULT ''
);

CREATE INDEX vod_item_category ON vod_item(source_id, kind, category_id, position);
CREATE INDEX vod_item_added ON vod_item(kind, added_at);
CREATE INDEX vod_item_title ON vod_item(kind, title_key);
CREATE INDEX vod_item_tmdb ON vod_item(kind, tmdb_id);

-- A refresh streams the provider's lists here first, a batch at a time, and swaps them in only once
-- they've all arrived: a failure part way keeps the old catalog, and nothing holds the whole list.
CREATE TABLE vod_item_staging (
    id TEXT NOT NULL PRIMARY KEY,
    source_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    provider_id TEXT NOT NULL,
    name TEXT NOT NULL,
    category_id TEXT NOT NULL,
    poster_url TEXT,
    year INTEGER,
    rating REAL,
    added_at INTEGER NOT NULL DEFAULT 0,
    tmdb_id INTEGER,
    container_ext TEXT,
    plot TEXT,
    url TEXT,
    position INTEGER NOT NULL,
    title_key TEXT NOT NULL DEFAULT '',
    search_name TEXT NOT NULL DEFAULT ''
);

-- Search (PLAN §4.3.14): vod_item's search_name by rowid, kept in step by the refresh.
CREATE VIRTUAL TABLE vod_fts USING fts4(search_name);

insertCategory:
INSERT OR REPLACE INTO vod_category(source_id, kind, category_id, name, position) VALUES ?;

-- Tests and one-off writes; a refresh goes through staging. Search sees the title once indexFts runs.
insertItem:
INSERT OR REPLACE INTO vod_item VALUES ?;

indexFts:
INSERT INTO vod_fts(docid, search_name) SELECT rowid, search_name FROM vod_item WHERE id = ?;

deleteAllForSource {
    DELETE FROM vod_fts WHERE docid IN (SELECT rowid FROM vod_item WHERE source_id = :sourceId);
    DELETE FROM vod_item WHERE source_id = :sourceId;
    DELETE FROM vod_category WHERE source_id = :sourceId;
    DELETE FROM vod_item_staging WHERE source_id = :sourceId;
}

-- ---- Hidden categories (VodCategoryFilter): their titles are dropped, so nothing else has to filter -------

allCategories:
SELECT source_id, kind, category_id, name FROM vod_category;

countInCategory:
SELECT count(*) FROM vod_item WHERE source_id = ? AND kind = ? AND category_id = ?;

deleteCategoryItems {
    DELETE FROM vod_fts WHERE docid IN (SELECT rowid FROM vod_item WHERE source_id = :sourceId AND kind = :kind AND category_id = :categoryId);
    DELETE FROM vod_item WHERE source_id = :sourceId AND kind = :kind AND category_id = :categoryId;
}

-- ---- A refresh: the lists stream into staging, then swap in whole -------------------------------

clearStaging:
DELETE FROM vod_item_staging WHERE source_id = ?;

-- OR IGNORE: providers list the same ID twice, and the first wins.
insertStaging:
INSERT OR IGNORE INTO vod_item_staging VALUES ?;

-- Run in one transaction with the new categories, after every list arrived.
swapInStaging {
    DELETE FROM vod_fts WHERE docid IN (SELECT rowid FROM vod_item WHERE source_id = :sourceId);
    DELETE FROM vod_item WHERE source_id = :sourceId;
    DELETE FROM vod_category WHERE source_id = :sourceId;
    INSERT INTO vod_item SELECT * FROM vod_item_staging WHERE source_id = :sourceId;
    INSERT INTO vod_fts(docid, search_name) SELECT rowid, search_name FROM vod_item WHERE source_id = :sourceId;
    DELETE FROM vod_item_staging WHERE source_id = :sourceId;
}

-- Rows cached before title_key and search_name existed, filled in a batch at a time on launch.
needsKeys:
SELECT id, name FROM vod_item WHERE search_name = '' LIMIT ?;

setKeys:
UPDATE vod_item SET title_key = ?, search_name = ? WHERE id = ?;

-- ---- Browsing ---------------------------------------------------------------------------------
-- Every query that returns titles brings the companion's TMDB match beside each (nas_tmdb, nas_poster),
-- so nothing keeps all the matches in memory.

-- The category column: each provider category with its title count, enabled sources only.
categories:
SELECT c.source_id, c.category_id, c.name, c.position, count(i.id) AS item_count
FROM vod_category c
JOIN source src ON src.id = c.source_id AND src.enabled = 1
LEFT JOIN vod_item i ON i.source_id = c.source_id AND i.kind = c.kind AND i.category_id = c.category_id
WHERE c.kind = ?
GROUP BY c.source_id, c.category_id
HAVING item_count > 0
ORDER BY src.created_at, c.position;

-- The web admin's Categories tab: every category, hidden ones (no titles kept) too.
allCategoriesCounted:
SELECT c.source_id, c.kind, c.category_id, c.name, count(i.id) AS item_count
FROM vod_category c
JOIN source src ON src.id = c.source_id AND src.enabled = 1
LEFT JOIN vod_item i ON i.source_id = c.source_id AND i.kind = c.kind AND i.category_id = c.category_id
GROUP BY c.source_id, c.kind, c.category_id
ORDER BY src.created_at, c.kind, c.position;

itemsInCategory:
SELECT i.*, t.tmdb_id AS nas_tmdb, t.poster AS nas_poster FROM vod_item i
LEFT JOIN vod_tmdb t ON t.item_id = i.id
WHERE i.source_id = ? AND i.kind = ? AND i.category_id = ? ORDER BY i.position;

recentlyAdded:
SELECT i.*, t.tmdb_id AS nas_tmdb, t.poster AS nas_poster FROM vod_item i
JOIN source src ON src.id = i.source_id AND src.enabled = 1
LEFT JOIN vod_tmdb t ON t.item_id = i.id
WHERE i.kind = ? ORDER BY i.added_at DESC, i.position LIMIT ?;

countForKind:
SELECT count(*) FROM vod_item i JOIN source src ON src.id = i.source_id AND src.enabled = 1 WHERE i.kind = ?;

-- An Xtream source with no titles: its movies and series failed to load, or never have.
countForSource:
SELECT count(*) FROM vod_item WHERE source_id = ?;

itemById:
SELECT i.*, t.tmdb_id AS nas_tmdb, t.poster AS nas_poster FROM vod_item i
LEFT JOIN vod_tmdb t ON t.item_id = i.id
WHERE i.id = ?;

-- The companion's matcher (PLAN §4.3.12): every title of every enabled source.
allItems:
SELECT i.*, t.tmdb_id AS nas_tmdb, t.poster AS nas_poster FROM vod_item i
JOIN source src ON src.id = i.source_id AND src.enabled = 1
LEFT JOIN vod_tmdb t ON t.item_id = i.id
ORDER BY i.source_id, i.kind, i.position;

-- ---- Titles across sources (PLAN §4.3.4, §4.3.8, §4.3.11): preferred source first -----------------

availableById:
SELECT count(*) FROM vod_item i JOIN source src ON src.id = i.source_id AND src.enabled = 1 WHERE i.id = ?;

byTitleKey:
SELECT i.*, t.tmdb_id AS nas_tmdb, t.poster AS nas_poster FROM vod_item i
JOIN source src ON src.id = i.source_id AND src.enabled = 1
LEFT JOIN vod_tmdb t ON t.item_id = i.id
WHERE i.kind = ? AND i.title_key = ?
ORDER BY src.created_at, i.source_id, i.position
LIMIT 200;

-- The provider's TMDB ID or the companion's; the caller drops a provider ID the companion overruled.
byTmdb:
SELECT i.*, t.tmdb_id AS nas_tmdb, t.poster AS nas_poster FROM vod_item i
JOIN source src ON src.id = i.source_id AND src.enabled = 1
LEFT JOIN vod_tmdb t ON t.item_id = i.id
WHERE i.kind = :kind AND (i.id IN (SELECT item_id FROM vod_tmdb WHERE tmdb_id = :tmdb) OR i.tmdb_id = :tmdb)
ORDER BY src.created_at, i.source_id, i.position
LIMIT 200;

-- Search (PLAN §4.3.14): every word as a prefix through the full-text index, then exact, prefix and
-- shorter titles first.
searchTitles:
SELECT i.*, t.tmdb_id AS nas_tmdb, t.poster AS nas_poster FROM vod_fts f
JOIN vod_item i ON i.rowid = f.docid
JOIN source src ON src.id = i.source_id AND src.enabled = 1
LEFT JOIN vod_tmdb t ON t.item_id = i.id
WHERE vod_fts MATCH :match AND i.kind = :kind
ORDER BY i.search_name = :exact DESC, i.search_name LIKE :prefix DESC, length(i.search_name), src.created_at, i.position
LIMIT :limit;

-- From the companion's VOD index (PLAN §4.3.12): each matched title's TMDB ID and poster, and the
-- TMDB lists and genres as shelves ("list:trending", "genre:Action"). Replaced whole on each fetch.
-- Device-local, not synced; without the NAS these stay empty and only provider data shows.
CREATE TABLE vod_tmdb (
    item_id TEXT NOT NULL PRIMARY KEY,
    tmdb_id INTEGER NOT NULL,
    poster TEXT
);

CREATE INDEX vod_tmdb_id ON vod_tmdb(tmdb_id);

CREATE TABLE vod_shelf (
    kind TEXT NOT NULL,
    shelf TEXT NOT NULL,
    position INTEGER NOT NULL,
    item_id TEXT NOT NULL,
    PRIMARY KEY (kind, shelf, position)
);

clearEnrichment {
    DELETE FROM vod_tmdb;
    DELETE FROM vod_shelf;
}

insertTmdb:
INSERT OR REPLACE INTO vod_tmdb(item_id, tmdb_id, poster) VALUES (?, ?, ?);

insertShelf:
INSERT OR REPLACE INTO vod_shelf(kind, shelf, position, item_id) VALUES (?, ?, ?, ?);

-- The Lists and Genres entries: shelves with at least one title of an enabled source.
-- Counted per title, as itemsInShelf shows them: a 4K and a plain copy of one show are one card.
shelves:
SELECT sh.shelf, count(DISTINCT coalesce(t.tmdb_id, i.tmdb_id, i.id)) AS item_count
FROM vod_shelf sh
JOIN vod_item i ON i.id = sh.item_id
JOIN source src ON src.id = i.source_id AND src.enabled = 1
LEFT JOIN vod_tmdb t ON t.item_id = i.id
WHERE sh.kind = ?
GROUP BY sh.shelf;

itemsInShelf:
SELECT i.*, t.tmdb_id AS nas_tmdb, t.poster AS nas_poster FROM vod_shelf sh
JOIN vod_item i ON i.id = sh.item_id
JOIN source src ON src.id = i.source_id AND src.enabled = 1
LEFT JOIN vod_tmdb t ON t.item_id = i.id
WHERE sh.kind = ? AND sh.shelf = ?
ORDER BY sh.position;

-- Observed only to learn that the catalog, the sources or the TMDB matches changed.
catalogTick:
SELECT (SELECT count(*) FROM vod_item) + (SELECT count(*) FROM source WHERE enabled = 1) + (SELECT count(*) FROM vod_tmdb);
