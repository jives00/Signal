-- Reminders (PLAN §4.3.4 → Reminders): profile scope, stored against the user channel plus the
-- program's title and start, so they follow a program a new guide build moves.
CREATE TABLE reminder (
    id TEXT NOT NULL PRIMARY KEY,
    profile_id TEXT NOT NULL,
    user_channel_id TEXT NOT NULL,
    title TEXT NOT NULL,
    start_ms INTEGER NOT NULL,
    stop_ms INTEGER NOT NULL,
    fired INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

CREATE INDEX reminder_start ON reminder(profile_id, start_ms);

remindersFor:
SELECT * FROM reminder WHERE profile_id = ? ORDER BY start_ms;

insertReminder:
INSERT INTO reminder(id, profile_id, user_channel_id, title, start_ms, stop_ms, fired, created_at) VALUES ?;

deleteReminder:
DELETE FROM reminder WHERE id = ?;

markFired:
UPDATE reminder SET fired = 1 WHERE id = ?;

moveReminder:
UPDATE reminder SET start_ms = ?, stop_ms = ? WHERE id = ?;

deleteEnded:
DELETE FROM reminder WHERE profile_id = ? AND stop_ms < ?;
