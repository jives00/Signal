-- Milestone 2 (guide): EPG sources, guide mappings and reminders.
CREATE TABLE epg_source (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    kind TEXT NOT NULL,
    url TEXT NOT NULL DEFAULT '',
    source_id TEXT,
    enabled INTEGER NOT NULL DEFAULT 1,
    time_shift_minutes INTEGER NOT NULL DEFAULT 0,
    position TEXT NOT NULL,
    last_built_at INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE guide_mapping (
    user_channel_id TEXT NOT NULL PRIMARY KEY,
    epg_source_id TEXT NOT NULL,
    guide_channel_id TEXT
);

CREATE TABLE reminder (
    id TEXT NOT NULL PRIMARY KEY,
    profile_id TEXT NOT NULL,
    user_channel_id TEXT NOT NULL,
    title TEXT NOT NULL,
    start_ms INTEGER NOT NULL,
    stop_ms INTEGER NOT NULL,
    fired INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

CREATE INDEX reminder_start ON reminder(profile_id, start_ms);
