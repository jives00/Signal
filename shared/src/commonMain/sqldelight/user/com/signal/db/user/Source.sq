-- Household scope (PLAN §9.1). The password column holds ciphertext from SecretBox, never plaintext (PLAN §5.7).
CREATE TABLE source (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    kind TEXT NOT NULL,
    url TEXT NOT NULL,
    username TEXT NOT NULL DEFAULT '',
    password_enc TEXT NOT NULL DEFAULT '',
    user_agent TEXT,
    referrer TEXT,
    enabled INTEGER NOT NULL DEFAULT 1,
    live_format TEXT NOT NULL DEFAULT 'TS',
    connection_limit INTEGER NOT NULL DEFAULT 2,
    expires_at INTEGER,
    -- What the provider allows (Xtream user_info.max_connections), kept on the device (9.sqm).
    provider_connections INTEGER,
    last_refreshed_at INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    created_at INTEGER NOT NULL,
    -- More logins to the same server, as SecretBox ciphertext of a JSON list; empty is none (11.sqm).
    accounts_enc TEXT NOT NULL DEFAULT ''
);

-- Sources the device's profile leaves out (the profile setting hidden_sources, PLAN §9.1 → Sources per
-- profile). Device-local, never synced: Settings rewrites it from the setting whenever that or the
-- profile changes, so list queries filter in SQL without observing the setting table, which changes on
-- every tune. Empty on the companion, which keeps every source.
CREATE TABLE source_hidden (
    source_id TEXT NOT NULL PRIMARY KEY
);

-- The sources this device shows: enabled for the household and not left out by its profile.
CREATE VIEW active_source AS
SELECT * FROM source WHERE enabled = 1 AND id NOT IN (SELECT source_id FROM source_hidden);

all:
SELECT * FROM source ORDER BY created_at;

active:
SELECT * FROM active_source ORDER BY created_at;

hiddenHere:
SELECT source_id FROM source_hidden;

hideHere:
INSERT INTO source_hidden(source_id) VALUES (?);

clearHiddenHere:
DELETE FROM source_hidden;

byId:
SELECT * FROM source WHERE id = ?;

upsert:
INSERT OR REPLACE INTO source(id, name, kind, url, username, password_enc, user_agent, referrer, enabled, live_format, connection_limit, expires_at, provider_connections, last_refreshed_at, last_error, created_at, accounts_enc)
VALUES ?;

-- The user's connection_limit is theirs (synced); the provider's own limit goes beside it.
markRefreshed:
UPDATE source SET last_refreshed_at = ?, last_error = NULL, expires_at = ?, provider_connections = ? WHERE id = ?;

markFailed:
UPDATE source SET last_error = ? WHERE id = ?;

delete:
DELETE FROM source WHERE id = ?;

count:
SELECT count(*) FROM source;
