-- Household scope (PLAN §9.1). The password column holds ciphertext from SecretBox, never plaintext (PLAN §5.7).
CREATE TABLE source (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    kind TEXT NOT NULL,
    url TEXT NOT NULL,
    username TEXT NOT NULL DEFAULT '',
    password_enc TEXT NOT NULL DEFAULT '',
    user_agent TEXT,
    referrer TEXT,
    enabled INTEGER NOT NULL DEFAULT 1,
    live_format TEXT NOT NULL DEFAULT 'TS',
    connection_limit INTEGER NOT NULL DEFAULT 2,
    expires_at INTEGER,
    last_refreshed_at INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    created_at INTEGER NOT NULL
);

all:
SELECT * FROM source ORDER BY created_at;

byId:
SELECT * FROM source WHERE id = ?;

upsert:
INSERT OR REPLACE INTO source(id, name, kind, url, username, password_enc, user_agent, referrer, enabled, live_format, connection_limit, expires_at, last_refreshed_at, last_error, created_at)
VALUES ?;

markRefreshed:
UPDATE source SET last_refreshed_at = ?, last_error = NULL, expires_at = ?, connection_limit = ? WHERE id = ?;

markFailed:
UPDATE source SET last_error = ? WHERE id = ?;

delete:
DELETE FROM source WHERE id = ?;

count:
SELECT count(*) FROM source;
