-- guide.db (PLAN §5.1, §6): programs keyed by EPG source and the guide's own channel IDs, never
-- by provider streams. Built whole beside the live file and swapped in; never migrated. Times are
-- UTC epoch milliseconds as the guide gives them; time shift is applied when read.

CREATE TABLE program (
    -- The rowid: program search's docid, and how program details refers to one.
    id INTEGER NOT NULL PRIMARY KEY,
    epg_source_id TEXT NOT NULL,
    guide_channel_id TEXT NOT NULL,
    start INTEGER NOT NULL,
    stop INTEGER NOT NULL,
    title TEXT NOT NULL,
    sub_title TEXT,
    description TEXT,
    categories TEXT,
    season INTEGER,
    episode INTEGER,
    episode_label TEXT,
    icon TEXT,
    rating TEXT,
    year INTEGER,
    -- 1 = new, 2 = live, 4 = previously shown.
    flags INTEGER NOT NULL DEFAULT 0,
    credits TEXT
);

CREATE INDEX program_channel ON program(epg_source_id, guide_channel_id, start);

CREATE TABLE guide_channel (
    epg_source_id TEXT NOT NULL,
    id TEXT NOT NULL,
    display_name TEXT NOT NULL,
    -- GuideNames.normalize, for mapping by name (PLAN §6 → Channel ↔ guide mapping, step 3).
    normalized_name TEXT NOT NULL,
    icon TEXT,
    PRIMARY KEY (epg_source_id, id)
);

-- Every display-name a guide channel lists, normalized: name mapping tries them all (PLAN §6, step 3).
CREATE TABLE guide_channel_name (
    epg_source_id TEXT NOT NULL,
    guide_channel_id TEXT NOT NULL,
    normalized_name TEXT NOT NULL
);

-- Program search (PLAN §4.3.14): the docid is the program's id. The text is folded by the app
-- (SearchText.fold: case, accents, junk characters) the same way queries are, so matching never
-- depends on which tokenizers the device's SQLite has.
CREATE VIRTUAL TABLE program_fts USING fts4(title, sub_title);

CREATE TABLE meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

insertProgram:
INSERT INTO program(id, epg_source_id, guide_channel_id, start, stop, title, sub_title, description, categories, season, episode, episode_label, icon, rating, year, flags, credits)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSearchText:
INSERT INTO program_fts(docid, title, sub_title) VALUES (?, ?, ?);

insertChannel:
INSERT OR REPLACE INTO guide_channel(epg_source_id, id, display_name, normalized_name, icon) VALUES (?, ?, ?, ?, ?);

insertChannelName:
INSERT INTO guide_channel_name(epg_source_id, guide_channel_id, normalized_name) VALUES (?, ?, ?);

channelNamesForSource:
SELECT guide_channel_id, normalized_name FROM guide_channel_name WHERE epg_source_id = ?;

channelNamesForSourceAll:
SELECT * FROM guide_channel_name WHERE epg_source_id = ?;

putMeta:
INSERT OR REPLACE INTO meta(key, value) VALUES (?, ?);

meta:
SELECT value FROM meta WHERE key = ?;

-- Programs on one guide channel overlapping [from, to), in guide time (unshifted).
programsBetween:
SELECT * FROM program
WHERE epg_source_id = ? AND guide_channel_id = ? AND stop > ? AND start < ?
ORDER BY start;

programById:
SELECT * FROM program WHERE id = ?;

channelsForSource:
SELECT id, normalized_name FROM guide_channel WHERE epg_source_id = ?;

-- Guide channels with at least one program, per source: a channel with no programs counts as no data.
-- A skip scan: one seek on program_channel per channel (the next one after the last), not a read of
-- every program. SELECT DISTINCT read them all, 870k on the Shield, before the guide's first row could
-- show (user, 2026-10-16: 5-10 s after opening).
channelsWithPrograms:
WITH RECURSIVE c(id) AS (
    SELECT min(guide_channel_id) FROM program WHERE epg_source_id = :epgSourceId
    UNION ALL
    SELECT (SELECT min(guide_channel_id) FROM program WHERE epg_source_id = :epgSourceId AND guide_channel_id > c.id) FROM c WHERE c.id IS NOT NULL
)
SELECT id AS guide_channel_id FROM c WHERE id IS NOT NULL;

countsBySource:
SELECT epg_source_id, count(DISTINCT guide_channel_id) AS channels, count(*) AS programs FROM program GROUP BY epg_source_id;

searchPrograms:
SELECT p.* FROM program_fts f
JOIN program p ON p.id = f.docid
WHERE program_fts MATCH ? AND p.stop > ?
ORDER BY p.start
LIMIT ?;

-- A build carries over the previous guide's data for an EPG source that failed to download.
programsForSource:
SELECT * FROM program WHERE epg_source_id = ? AND stop > ?;

guideChannelsForSource:
SELECT * FROM guide_channel WHERE epg_source_id = ?;

-- Coverage diagnostics: is a tvg-id in any guide, whatever its case?
guideChannelByIdAnyCase:
SELECT g.epg_source_id, g.id, (SELECT count(*) FROM program p WHERE p.epg_source_id = g.epg_source_id AND p.guide_channel_id = g.id) AS programs
FROM guide_channel g WHERE lower(g.id) = lower(?) LIMIT 1;

-- Game titles (the NAS's GameLookup): programs in [from, to), guide time, whose title names a sport
-- or league it can look up. GameTitles.isGame narrows them further.
gameCandidates:
SELECT id, epg_source_id, guide_channel_id, start, title, sub_title, description, categories FROM program
WHERE stop > ? AND start < ? AND (
    title LIKE '%football%' OR title LIKE '%basketball%' OR title LIKE '%baseball%' OR title LIKE '%hockey%'
    OR title LIKE '%soccer%' OR title LIKE '%volleyball%' OR title LIKE '%NFL%' OR title LIKE '%NBA%' OR title LIKE '%MLB%'
    OR title LIKE '%NHL%' OR title LIKE '%MLS%' OR title LIKE '%NWSL%' OR title LIKE '%league%' OR title LIKE '%liga%'
    OR title LIKE '%serie a%' OR title LIKE '%ligue 1%' OR title LIKE '%EFL%'
);

setProgramTitle:
UPDATE program SET title = ? WHERE id = ?;

deleteSearchText:
DELETE FROM program_fts WHERE docid = ?;

-- Voice commands (PLAN §4.3.14 → Voice commands, phase 2): games with their teams in the title,
-- airing in [from, to), for the team names a voice command can say. Guide time.
gameTitles:
SELECT DISTINCT title FROM program WHERE stop > ? AND start < ? AND title LIKE '% vs. %';
