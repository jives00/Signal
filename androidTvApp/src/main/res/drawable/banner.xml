<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder launcher banner (320×180): the theme's slate with an accent bar. The real logo
     and banner are an open decision (PLAN §4.4); the launcher shows the app label beside it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#30343B" />
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#2F6FE8" />
        </shape>
    </item>
</layer-list>
