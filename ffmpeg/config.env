# The LGPL FFmpeg build for Media3's FFmpeg extension (PLAN §5.3 → FFmpeg build).
# Changing any value here and running the "FFmpeg (LGPL)" workflow produces a new AAR, which is
# then committed to androidTvApp/libs/. MEDIA3_VERSION must match androidx-media3 in
# gradle/libs.versions.toml, or the extension won't load.
MEDIA3_VERSION=1.11.1
FFMPEG_BRANCH=release/6.0
NDK_VERSION=26.3.11579264
# Must not exceed the app's minSdk.
ANDROID_ABI=30
# Audio decoders only. Never add a GPL-only component; the workflow fails if configure reports GPL.
ENABLED_DECODERS="ac3 eac3 dca truehd mlp mp3 aac opus vorbis flac"
